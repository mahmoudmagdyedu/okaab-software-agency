{
  "expo": {
    "name": "عُقاب للتعلّم",
    "slug": "okaab-learning",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "okaab",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "org.okaab.learning",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#141210" }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E8A33D",
          "defaultChannel": "learning"
        }
      ],
      "@clerk/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح لعُقاب باختيار صورة لحسابك فقط.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "apiUrl": "https://okaab.org/api/v1" }
  }
}
