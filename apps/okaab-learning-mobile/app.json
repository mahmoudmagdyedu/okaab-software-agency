{
  "expo": {
    "name": "عُقاب",
    "slug": "okaab-learning",
    "version": "1.2.7",
    "icon": "./assets/okaab-icon-v2.png",
    "orientation": "portrait",
    "scheme": "okaab",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "org.okaab.learning",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/okaab-icon-foreground.png",
        "backgroundColor": "#181511"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#E8A33D",
          "defaultChannel": "learning"
        }
      ],
      "@clerk/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "اسمح لعُقاب باختيار صورة لحسابك فقط.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://okaab.org/api/v1",
      "router": {},
      "eas": {
        "projectId": "196cfc7c-471b-4fb9-ba8e-cf7e2be63d3c"
      }
    },
    "owner": "okaaborg"
  }
}
